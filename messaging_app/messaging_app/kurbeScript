#!/usr/bin/env bash

# Script: kurbeScript
# Objective: Start a local Kubernetes cluster using Minikube,
# verify the cluster status, and list available pods.

set -e

# Check if minikube is installed
if ! command -v minikube >/dev/null 2>&1; then
    echo "Minikube is not installed. Please install Minikube first: https://minikube.sigs.k8s.io/docs/start/"
    exit 1
fi

# Start Minikube cluster
echo "Starting Minikube cluster..."
minikube start

# Verify cluster info
echo "Checking Kubernetes cluster info..."
kubectl cluster-info

# Retrieve available pods
echo "Listing pods in the default namespace..."
kubectl get pods

echo "Kubernetes cluster setup and verification complete."

