#!/usr/bin/env bash

# Script: kubctl-0x01
# Objective: Scale Django Kubernetes deployment, verify pods, run load testing, and monitor resources.

set -e

DEPLOYMENT_NAME="messaging-app-deployment"
NAMESPACE="default"

# Scale deployment to 3 replicas
echo "Scaling deployment '$DEPLOYMENT_NAME' to 3 replicas..."
kubectl scale deployment "$DEPLOYMENT_NAME" --replicas=3 -n "$NAMESPACE"

# Verify running pods
echo "\nVerifying pods..."
kubectl get pods -n "$NAMESPACE"

# Load testing using wrk
echo "\nStarting load test with wrk..."
if ! command -v wrk >/dev/null 2>&1; then
    echo "wrk is not installed. Please install it first: https://github.com/wg/wrk"
else
    # Assuming service runs at port 8000 inside cluster via minikube service tunnel
    APP_URL="http://localhost:8000"
    echo "Running wrk against $APP_URL ..."
    wrk -t4 -c50 -d20s "$APP_URL"
fi

# Monitor resource usage
echo "\nMonitoring resource usage..."
kubectl top pods -n "$NAMESPACE"

echo "\nScaling test completed successfully."

