#!/bin/bash
set -e

NAMESPACE=default
DEPLOYMENT=django-blue
SERVICE_URL=http://localhost:8000  # Change if your service URL differs

echo "🚀 Applying updated deployment (image v2.0)..."
kubectl apply -f messaging_app/blue_deployment.yaml -n $NAMESPACE

echo "🔄 Triggering rolling update..."
kubectl rollout status deployment/$DEPLOYMENT -n $NAMESPACE

echo "📡 Testing app availability during update..."
for i in {1..20}; do
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" $SERVICE_URL)
    TIMESTAMP=$(date +"%T")
    echo "[$TIMESTAMP] HTTP Response: $RESPONSE"
    sleep 1
done

echo "✅ Rolling update complete. Current pods:"
kubectl get pods -l app=django,version=blue -n $NAMESPACE

